<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notifications & Alarms -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 精确定时提醒。
         只保留 SCHEDULE_EXACT_ALARM：Android 12(API 31/32) 默认授予、用户可在设置里关闭，
         关闭时 NotificationHelper 会降级为非精确并在界面上明确提示。
         不再声明 USE_EXACT_ALARM —— 它安装即授予、用户不可撤销，与本 App 的提示逻辑冲突，
         且上架 Google Play 需要额外提交用途声明。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 联网：**只**用于「每日格言」在联网时去公开语录接口取一条句子。
         边界写在这里，改代码时请守住：
         - 请求是单向 GET，不携带任何用户数据，不上传打卡记录 / 照片 / 备份；
         - 无网络或请求失败时静默回退到内置格言库（data/DailyQuotes.kt），功能不受影响；
         - 不声明 ACCESS_NETWORK_STATE：不预判网络，直接发请求、失败即降级 ——
           Android 无网时 UnknownHostException 是立刻抛出的，不需要先探测，
           少一个权限就少一份解释成本。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HabitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HabitTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HabitTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarm Receiver for exact daily reminders -->
        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <!-- Notification Direct Check-in Action Receiver -->
        <receiver
            android:name=".notification.CheckInActionReceiver"
            android:exported="false" />

        <!-- Boot Completed Receiver to re-schedule all alarms upon device restart -->
        <receiver
            android:name=".notification.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
